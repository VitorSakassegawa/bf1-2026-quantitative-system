# === DATABASE ===
# The password appears TWICE. Postgres is created with POSTGRES_PASSWORD, and
# the app connects with the one embedded in DATABASE_URL — set both to the same
# value or every query fails with InvalidPasswordError.
POSTGRES_USER=bf1user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=bf1_2026
DATABASE_URL=postgresql+asyncpg://bf1user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/bf1_2026

# === REDIS ===
REDIS_URL=redis://redis:6379/0

# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_ADMIN_CHAT_ID=YOUR_ADMIN_CHAT_ID

# === OPENWEATHER ===
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY

# === APP ===
SECRET_KEY=CHANGE_ME_RANDOM_64_CHARS
ENVIRONMENT=production
LOG_LEVEL=INFO
# Comma-separated. Do NOT use "*" in production: combined with credentialed
# requests it makes the server echo back any origin that asks.
ALLOWED_ORIGINS=https://yourdomain.com

# === API AUTHENTICATION ===
# Required outside development — the API refuses guarded routes without them.
# Generate each with:  openssl rand -hex 32
# WRITE_API_KEY guards POST /races, /drivers, /bets and /simulate.
# ADMIN_API_KEY guards every /api/v1/admin/* route.
# Send them as the X-API-Key and X-Admin-Key headers respectively.
WRITE_API_KEY=
ADMIN_API_KEY=

# Set false to run WITHOUT any API authentication. Reasonable for a LAN-only
# box (a Synology on your home network, a VPN-only host). Not appropriate for
# anything reachable from the internet: with this off, anyone who can reach the
# port can create races and drivers — which poisons the ELO grid the strategies
# are built from — and can pin the CPU via /simulate.
REQUIRE_API_KEYS=true

# Interface the API is published on.
#   127.0.0.1  only this host (default). nginx still serves it on :80.
#   0.0.0.0    every interface — use this on a LAN-only box so other devices
#              on the network can reach the API directly on :8000.
API_BIND=127.0.0.1

# Publish /docs, /redoc and /openapi.json. Leave false in production: the
# schema advertises the admin surface to anonymous visitors.
ENABLE_DOCS=false

# === ML ===
MODELS_STORAGE_PATH=/app/models_storage
MONTE_CARLO_SIMULATIONS=20000
DEFAULT_AGGRESSIVENESS=balanced

# === SCRAPING ===
SCRAPING_DELAY_SECONDS=1.0
SCRAPING_MAX_RETRIES=3
